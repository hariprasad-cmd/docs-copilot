# Copy this file to .env:  cp .env.example .env

# Which LLM to use: "ollama" (free, runs on your computer) or "claude" (needs an API key)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b

# Only needed when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Other settings (these are the defaults)
TOP_K=4
COMPANY_NAME=Brightwave Internet
